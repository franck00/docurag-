{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocuRag": {
    "Cosmos": { "Database": "docurag" },
    "ServiceBus": { "QueueName": "doc-processing" },
    "OpenAI": {
      "EmbeddingDeployment": "text-embedding-3-small",
      "ChatDeployment": "gpt-4o-mini",
      "EmbeddingDimensions": 1536
    },
    "Rag": { "TopK": 5, "MaxOutputTokens": 800, "Temperature": 0.1 },
    "Cache": { "SimilarityThreshold": 0.95 }
  },
  "FeatureManagement": {
    "SemanticCache": true
  }
}
